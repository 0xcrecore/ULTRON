# =============================================================================
# ULTRON .env — VORLAGE. Kopiere zu .env und trage echte Werte ein.
# NIEMALS .env committen! (.gitignore deckt das ab)
# =============================================================================

# --- S3 / RunPod Network Storage ---
S3_ENDPOINT_URL=https://s3api-eu-ro-1.runpod.io
S3_BUCKET_NAME=your-bucket-id
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=eu-ro-1

# --- Telegram ---
ULTRON_BOT_TOKEN=your-telegram-bot-token
ULTRON_ALLOWED_USER_ID=your-telegram-user-id

# --- RunPod API (für den Telegram-Bot, um den Endpoint zu triggern) ---
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id-after-deploy

# --- Model ---
MODEL_FILENAME=qwen2.5-coder-32b-abliterated-Q4_K_M.gguf
S3_MODEL_PREFIX=models/

# --- llama-server ---
CONTEXT_SIZE=8192
N_PARALLEL=4
LLAMA_SERVER_API_KEY=optional-extra-auth-secret
